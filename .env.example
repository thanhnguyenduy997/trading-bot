APP_NAME=Trading Web App
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=4320
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading_app
ENCRYPTION_KEY=replace-with-generated-fernet-key
MAX_PREVIEW_DRIFT_PERCENT=25
SCRATCH_MANUAL_THRESHOLD_R=0.5
TRADE_MONITOR_ENABLED=false
TRADE_MONITOR_INTERVAL_SECONDS=15
MT5_HISTORY_AUTO_SYNC_ENABLED=true
MT5_HISTORY_AUTO_SYNC_INTERVAL_SECONDS=180
MT5_HISTORY_AUTO_SYNC_MAX_ACCOUNTS_PER_CYCLE=3
MT5_HISTORY_AUTO_SYNC_STALE_AFTER_SECONDS=180
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5
